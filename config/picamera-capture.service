[Unit]
Description=PiCameraArray Trigger Capture Service
# Wait for the capture SSD before starting. Wants+After (not Requires) so a
# missing SSD still lets the agent come up and report the problem instead of
# leaving the camera silently dead. The unit name is the escaped mount point
# /media/pi/HIKSEMI; it exists because prepare_ssd.sh puts it in /etc/fstab.
After=local-fs.target media-pi-HIKSEMI.mount
Wants=media-pi-HIKSEMI.mount

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/pi/PiCameraArray/capture
ExecStartPre=/bin/sleep 20
ExecStart=/home/pi/PiCameraArray/capture/startup.sh
# Hold the shared READY line LOW whenever the agent is not running, so the
# trigger box never reads a crashed Pi as ready. '-' ignores a failure.
ExecStopPost=-/usr/bin/pinctrl set 26 op dl
# Per-Pi lamp: agent stopped -> red on, green off (ACT/PWR or led0/led1).
ExecStopPost=-/bin/sh -c 'for d in /sys/class/leds/PWR /sys/class/leds/led1; do [ -d $$d ] && { echo none > $$d/trigger; echo 1 > $$d/brightness; break; }; done; for d in /sys/class/leds/ACT /sys/class/leds/led0; do [ -d $$d ] && { echo none > $$d/trigger; echo 0 > $$d/brightness; break; }; done'
Restart=on-failure
RestartSec=5
KillMode=mixed

[Install]
WantedBy=multi-user.target
